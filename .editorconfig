# Mirrors the conventions nixpkgs enforces in its own .editorconfig, so files
# here need no reformatting if lightpanda.nix is upstreamed.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown; trimming them silently
# reflows paragraphs.
trim_trailing_whitespace = false
